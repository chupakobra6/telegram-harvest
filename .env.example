# Daily Telegram Harvest account credentials from https://my.telegram.org.
# Used by --profile main. Daily reports are normally run with this profile.
TG_HARVEST_DAILY_APP_ID=12345678
TG_HARVEST_DAILY_APP_HASH=your_main_account_app_hash

# User account login phone for the daily profile. If empty, `login` asks interactively.
# TG_HARVEST_DAILY_PHONE=+10000000000

# Optional 2FA password. If empty, login asks interactively.
# TG_HARVEST_DAILY_PASSWORD=your_telegram_2fa_password

# Optional daily local paths. Defaults:
#   session: .sessions/main.json
#   state:   .state/daily
# User-facing daily reports are written to reports/daily/ as Markdown by default.
# TG_HARVEST_DAILY_SESSION_PATH=.sessions/main.json
# TG_HARVEST_DAILY_STATE_DIR=.state/daily
# Include selected incoming senders in daily as chat_id:sender_id pairs.
# TG_HARVEST_DAILY_ADDITIONAL_SENDERS=3740223926:8718303786

# Dedicated study account API credentials. Required for --profile study login/runtime.
TG_HARVEST_STUDY_APP_ID=12345678
TG_HARVEST_STUDY_APP_HASH=your_study_account_app_hash
# If empty, `login` asks interactively.
# TG_HARVEST_STUDY_PHONE=+10000000000
# TG_HARVEST_STUDY_SESSION_PATH=.sessions/study.json
# TG_HARVEST_STUDY_STATE_DIR=.state

# Optional hard allowlist. When set, dump/sync/topics refuse any chat outside this list.
# Use numeric IDs from `chats --query ...`, comma-separated.
# TG_HARVEST_STUDY_ALLOWED_CHATS=1234567890,@study_chat

# Media safety caps used by dump/sync/daily when media download is enabled.
# Set a value to 0 only for explicit one-off runs; manual download-media commands do not use caps.
# Override with CLI flags such as --max-photo-bytes or --max-video-bytes.
# Defaults: photo/image 10 MiB, generic document 10 MiB, audio/voice 50 MiB, round/video 200 MiB.
# Daily generic video transcription has an extra code-owned phone prefilter:
# vertical, <=6 minutes, <=80 MiB, and no more than 1080x1920.

# Daily audio/video transcription. The selected production profile is
# whisper.cpp large-v3-turbo q5_0 + Metal + beam search + whole-file Silero
# speech gate. Backend, Metal acceleration, Russian language, four CPU helper
# threads, beam size 5, and one GPU worker are fixed by the production profile.
#
# ffmpeg extracts mono 16 kHz PCM WAV. whisper-server keeps the model loaded for
# the current run; a bounded queue overlaps Telegram download with local ASR.
# Audio/video source files are temporary and are deleted after transcription.
# Existing transcript cache entries are reused by Telegram document id plus
# model/decode/gate/runtime identity.
# Detailed ASR logs are written to .state/daily/asr/YYYY-MM-DD.jsonl.
# TG_HARVEST_DAILY_FFMPEG_COMMAND=ffmpeg
# TG_HARVEST_DAILY_WHISPER_COMMAND=.state/asr-runtime/whisper.cpp/build-metal/bin/whisper-server
# TG_HARVEST_DAILY_WHISPER_MODEL_PATH=.state/asr-runtime/whisper.cpp/models/ggml-large-v3-turbo-q5_0.bin
# Required by the production profile. This gate only decides whether the whole
# file contains speech; it never cuts or concatenates the audio.
# TG_HARVEST_DAILY_WHISPER_SPEECH_GATE_MODEL_PATH=.state/asr-runtime/whisper.cpp/models/ggml-silero-v6.2.0.bin

# Optional MTProto proxy. HTTP_PROXY/HTTPS_PROXY work through HTTP CONNECT.
# ALL_PROXY=socks5://127.0.0.1:1080
# NO_PROXY=localhost,127.0.0.1
