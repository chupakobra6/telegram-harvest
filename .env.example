# Telegram app credentials from https://my.telegram.org.
TG_STUDY_APP_ID=12345678
TG_STUDY_APP_HASH=your_telegram_app_hash

# User account login. Prefer a dedicated account when possible.
TG_STUDY_PHONE=+10000000000

# Optional 2FA password. If empty, login asks interactively.
# TG_STUDY_PASSWORD=your_telegram_2fa_password

# Optional local paths. Defaults:
#   session: .sessions/user.json
#   state:   .state
# TG_STUDY_SESSION_PATH=.sessions/user.json
# TG_STUDY_STATE_DIR=.state

# Optional hard allowlist. When set, dump/sync/topics refuse any chat outside this list.
# Use numeric IDs from `chats --query ...`, comma-separated.
# TG_STUDY_ALLOWED_CHATS=1234567890,@study_chat

# If my.telegram.org is temporarily rate-limited but Telegram Desktop is already logged in:
#   go run ./cmd/telegram-study-harvest import-tdesktop --account-index 1
#   go run ./cmd/telegram-study-harvest me

# Conservative read-only pacing.
TG_STUDY_RPC_SPACING_MS=1500
TG_STUDY_HISTORY_BATCH_SIZE=80
TG_STUDY_HISTORY_LIMIT=500
TG_STUDY_MAX_BATCHES=20

# Separate daily/personal profile. These commands do not use Telegram Desktop defaults:
#   go run ./cmd/telegram-study-harvest daily-login
#   go run ./cmd/telegram-study-harvest daily --date yesterday
# You can use TG_HARVEST_* instead of TG_DAILY_* for the same profile.
# TG_DAILY_APP_ID=12345678
# TG_DAILY_APP_HASH=your_main_account_app_hash
# TG_DAILY_PHONE=+10000000000
# TG_DAILY_PASSWORD=your_telegram_2fa_password
# TG_DAILY_SESSION_PATH=.sessions/daily.json
# TG_DAILY_STATE_DIR=.state/daily
# TG_DAILY_RPC_SPACING_MS=1500
# TG_DAILY_HISTORY_BATCH_SIZE=80
# TG_DAILY_HISTORY_LIMIT=500
# TG_DAILY_MAX_BATCHES=20
# TG_DAILY_DIALOG_LIMIT=500

# Optional local transcription hook for daily voice/audio/round video files.
# The command may write {output} or print transcript text to stdout.
# TG_DAILY_TRANSCRIBE_CMD=whisper-cli --language ru --input {input} --output {output}

# Optional MTProto proxy. HTTP_PROXY/HTTPS_PROXY work through HTTP CONNECT.
# ALL_PROXY=socks5://127.0.0.1:1080
# NO_PROXY=localhost,127.0.0.1
