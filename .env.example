# Telegram app credentials from https://my.telegram.org.
TG_STUDY_APP_ID=12345678
TG_STUDY_APP_HASH=0123456789abcdef0123456789abcdef

# User account login. Prefer a dedicated account when possible.
TG_STUDY_PHONE=+79990000000

# Optional 2FA password. If empty, login asks interactively.
# TG_STUDY_PASSWORD=your_telegram_2fa_password

# Optional local paths. Defaults:
#   session: .sessions/user.json
#   state:   .state
# TG_STUDY_SESSION_PATH=/Users/igor/projects/telegram-study-harvest/.sessions/user.json
# TG_STUDY_STATE_DIR=/Users/igor/projects/study/.study_state/telegram

# Optional hard allowlist. When set, dump/sync/topics refuse any chat outside this list.
# Use numeric IDs from `chats --query ...`, comma-separated.
# TG_STUDY_ALLOWED_CHATS=4894337038,2949606711,2992807434

# If my.telegram.org is temporarily rate-limited but Telegram Desktop is already logged in:
#   go run ./cmd/telegram-study-harvest import-tdesktop --account-index 1
#   go run ./cmd/telegram-study-harvest me

# Conservative read-only pacing.
TG_STUDY_RPC_SPACING_MS=1500
TG_STUDY_HISTORY_BATCH_SIZE=80
TG_STUDY_HISTORY_LIMIT=500
TG_STUDY_MAX_BATCHES=20

# Optional MTProto proxy. HTTP_PROXY/HTTPS_PROXY work through HTTP CONNECT.
# ALL_PROXY=socks5://127.0.0.1:1080
# NO_PROXY=localhost,127.0.0.1
