# API-данные приложения из https://my.telegram.org для профиля main.
# Этот профиль используется для личных дневных отчётов.
TG_HARVEST_DAILY_APP_ID=12345678
TG_HARVEST_DAILY_APP_HASH=your_main_account_app_hash

# Номер основного аккаунта. Если не задан, `login` спросит интерактивно.
# TG_HARVEST_DAILY_PHONE=+10000000000

# Необязательный пароль 2FA. Если не задан, login спросит интерактивно.
# TG_HARVEST_DAILY_PASSWORD=your_telegram_2fa_password

# Необязательные локальные пути daily. Значения по умолчанию:
#   session: .sessions/main.json
#   state:   .state/daily
# Markdown-отчёты для пользователя по умолчанию записываются в reports/daily/.
# TG_HARVEST_DAILY_SESSION_PATH=.sessions/main.json
# TG_HARVEST_DAILY_STATE_DIR=.state/daily
# Дополнительные отправители daily — пары chat_id:sender_id.
# TG_HARVEST_DAILY_ADDITIONAL_SENDERS=3740223926:8718303786

# API-данные учебного профиля. Нужны для входа и работы --profile study.
TG_HARVEST_STUDY_APP_ID=12345678
TG_HARVEST_STUDY_APP_HASH=your_study_account_app_hash
# Если номер не задан, `login` спросит интерактивно.
# TG_HARVEST_STUDY_PHONE=+10000000000
# TG_HARVEST_STUDY_SESSION_PATH=.sessions/study.json
# TG_HARVEST_STUDY_STATE_DIR=.state

# Необязательный список разрешённых чатов: dump/sync/topics читают только их.
# Числовые ID из `chats --query ...` указываются через запятую.
# TG_HARVEST_STUDY_ALLOWED_CHATS=1234567890,@study_chat

# Дополнительные аккаунты регистрируются командой `account add --name <имя>
# --api-profile main|study`. Они используют выбранные API ID/hash выше, но
# авторизуются отдельно через `--profile <имя> login` и хранят сессии и архивы
# в приватном каталоге пользователя вне репозитория. Отдельных env-переменных
# для каждого аккаунта нет.
# Вход в аккаунт: `--profile <имя> login`; потребуются его номер, код Telegram
# и пароль 2FA при необходимости. Файлы Telegram Desktop не используются.

# При скачивании dump/sync/daily применяют ограничения размера медиа.
# Значение 0 допустимо для явно запрошенного разового прохода;
# ручные download-media команды эти ограничения не применяют.
# Для изменения используй CLI-флаги --max-photo-bytes, --max-video-bytes и другие.
# По умолчанию: фото/изображение 10 MiB, документ 10 MiB, аудио/голосовое 50 MiB,
# круговое/обычное видео 200 MiB. Для ASR обычного видео дополнительно действует
# фильтр phone: вертикальное, <=6 минут, <=80 MiB, не выше 1080x1920.

# Распознавание аудио/видео: whisper.cpp large-v3-turbo q5_0 + Metal.
# Единый adaptive-media-v2 выбирает стратегию по длительности и началу речи.
# Язык определяется автоматически. Короткое аудио передаётся целиком;
# для длинного или позднего начала речи используются Silero-границы,
# обрезка вступительной тишины и timestamped decode с проверкой последней речи.
# Четыре CPU-потока, beam size 5 и один GPU-обработчик заданы в коде.
#
# ffmpeg готовит mono 16 kHz PCM WAV. whisper-server загружает модель при первой
# работе с речью и переиспользует до конца запуска. Ограниченная очередь
# совмещает загрузку Telegram с локальным ASR. Временное аудио/видео удаляется
# после обработки. Кэш учитывает ID медиа, модель, стратегию, decode/gate/runtime.
# Подробный лог ASR: .state/daily/asr/YYYY-MM-DD.jsonl.
# TG_HARVEST_DAILY_FFMPEG_COMMAND=ffmpeg
# TG_HARVEST_DAILY_WHISPER_COMMAND=.state/asr-runtime/whisper.cpp/build-metal/bin/whisper-server
# TG_HARVEST_DAILY_WHISPER_MODEL_PATH=.state/asr-runtime/whisper.cpp/models/ggml-large-v3-turbo-q5_0.bin
# Модель Silero обязательна; её границы речи используются адаптивной политикой.
# TG_HARVEST_DAILY_WHISPER_SPEECH_GATE_MODEL_PATH=.state/asr-runtime/whisper.cpp/models/ggml-silero-v6.2.0.bin

# Необязательный MTProto proxy. HTTP_PROXY/HTTPS_PROXY используют HTTP CONNECT.
# ALL_PROXY=socks5://127.0.0.1:1080
# NO_PROXY=localhost,127.0.0.1
