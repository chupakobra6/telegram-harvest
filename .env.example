# Main Telegram Harvest account credentials from https://my.telegram.org.
# Used by daily-* commands.
TG_HARVEST_APP_ID=12345678
TG_HARVEST_APP_HASH=your_main_account_app_hash

# User account login for daily harvest.
TG_HARVEST_PHONE=+10000000000

# Optional 2FA password. If empty, login asks interactively.
# TG_HARVEST_PASSWORD=your_telegram_2fa_password

# Optional daily local paths. Defaults:
#   session: .sessions/daily.json
#   state:   .state/daily
# TG_HARVEST_SESSION_PATH=.sessions/daily.json
# TG_HARVEST_STATE_DIR=.state/daily

# Optional dedicated study account settings.
# TG_HARVEST_STUDY_APP_ID=12345678
# TG_HARVEST_STUDY_APP_HASH=your_study_account_app_hash
# TG_HARVEST_STUDY_PHONE=+10000000000
# TG_HARVEST_STUDY_SESSION_PATH=.sessions/user.json
# TG_HARVEST_STUDY_STATE_DIR=.state

# Optional hard allowlist. When set, dump/sync/topics refuse any chat outside this list.
# Use numeric IDs from `chats --query ...`, comma-separated.
# TG_HARVEST_STUDY_ALLOWED_CHATS=1234567890,@study_chat

# If my.telegram.org is temporarily rate-limited but Telegram Desktop is already logged in:
#   go run ./cmd/telegram-harvest import-tdesktop --account-index 1
#   go run ./cmd/telegram-harvest me

# Conservative read-only pacing for the main daily harvest account.
# Use TG_HARVEST_STUDY_* for different study-account pacing.
TG_HARVEST_RPC_SPACING_MS=1500
TG_HARVEST_HISTORY_BATCH_SIZE=80
TG_HARVEST_HISTORY_LIMIT=500
TG_HARVEST_MAX_BATCHES=20
# TG_HARVEST_DIALOG_LIMIT=500

# Media safety caps used by dump/sync/daily when media download is enabled.
# Set a value to 0 only for explicit one-off runs; manual download-media commands do not use caps.
# Override with CLI flags such as --max-photo-bytes or --max-video-bytes.
# Defaults: photo/image 10 MiB, generic document 10 MiB, audio/voice 50 MiB, video/round-video 200 MiB.

# Daily audio/video transcription. Vosk is the default path when command + model are set.
# ffmpeg is used to extract mono 16 kHz PCM WAV, then the Vosk helper runs as:
#   <command> <model-dir> <wav-path> [grammar-json-path]
# Audio/video source files are temporary and are deleted after transcription.
# Existing transcript cache entries are reused by Telegram document id.
# TG_HARVEST_VOSK_COMMAND=/usr/local/bin/vosk-transcribe
# TG_HARVEST_VOSK_MODEL_PATH=~/projects/shelfy/models/vosk-model-small-ru-0.22
# TG_HARVEST_VOSK_GRAMMAR_PATH=
# TG_HARVEST_FFMPEG_COMMAND=ffmpeg
# TG_HARVEST_RETENTION_DAYS=14

# Optional custom transcription hook override. When set, it takes precedence over Vosk.
# The command may write {output} or print transcript text to stdout.
# TG_HARVEST_TRANSCRIBE_CMD=whisper-cli --language ru --input {input} --output {output}

# Optional MTProto proxy. HTTP_PROXY/HTTPS_PROXY work through HTTP CONNECT.
# ALL_PROXY=socks5://127.0.0.1:1080
# NO_PROXY=localhost,127.0.0.1
